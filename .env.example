# ============================================================
# SYNAPSYS API — Environment Configuration
# Copy this file to .env and fill in the values.
# Never commit your actual .env file.
# ============================================================

# ── PostgreSQL ──────────────────────────────────────────────
SYNAPSYS_DB_URL=jdbc:postgresql://localhost:5432/synapsys
SYNAPSYS_DB_USER=synapsys
SYNAPSYS_DB_PASSWORD=synapsys

# ── JWT Access Token ─────────────────────────────────────────
# Secret key used to sign access tokens (min. 32 chars recommended).
SYNAPSYS_JWT_SECRET=xMq20aUkYb4IgW92JL7V9IG6IQlfANNUelo4xcetKgq
# Access token lifetime in minutes (default: 15).
SYNAPSYS_JWT_EXPIRY_MINUTES=15

# ── Refresh Token ────────────────────────────────────────────
# Opaque refresh token lifetime in days (default: 30).
SYNAPSYS_REFRESH_TOKEN_EXPIRY_DAYS=30

# ── Cookies ──────────────────────────────────────────────────
# Set to false for local HTTP development; defaults to true in production (HTTPS).
SYNAPSYS_COOKIE_SECURE=false

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the frontend.
SYNAPSYS_CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Database Seeder ──────────────────────────────────────────
# Initial admin account created on first run.
SYNAPSYS_SEED_USERNAME=admin
SYNAPSYS_SEED_EMAIL=admin@synapsys.local
SYNAPSYS_SEED_PASSWORD=changeme

# ── Swagger UI ───────────────────────────────────────────────
# Disabled by default in production; enable locally for API exploration.
SWAGGER_ENABLED=true