# Base de données PostgreSQL
SYNAPSYS_DB_URL=jdbc:postgresql://localhost:5432/synapsys
SYNAPSYS_DB_USER=synapsys
SYNAPSYS_DB_PASSWORD=

# JWT (access token) — min 32 caractères aléatoires
SYNAPSYS_JWT_SECRET=
SYNAPSYS_JWT_EXPIRY_MINUTES=15

# Refresh token
SYNAPSYS_REFRESH_TOKEN_EXPIRY_DAYS=30

# Cookies (false en local HTTP, true en production HTTPS)
SYNAPSYS_COOKIE_SECURE=false